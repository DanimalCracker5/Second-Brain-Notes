rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /backups/{backupId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
      match /documents/{documentId}/backups/{backupId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Fast per-note channel so two devices on the same account can edit one
      // note at once without waiting for the whole account document to save.
      match /liveNotes/{noteId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // A share is addressed by its unguessable document ID and is not listable.
    // Anyone with the link may read it. The owner can always change it. If the
    // owner turns on allowEdit, any signed-in visitor may update the contents
    // but cannot take ownership, change the type, or disable editing.
    match /shared/{shareId} {
      allow get: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.shareId == shareId
                    && request.resource.data.type in ['note', 'script'];
      allow update: if request.auth != null
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.shareId == resource.data.shareId
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (resource.data.ownerId == request.auth.uid
                        || (resource.data.allowEdit == true
                            && request.resource.data.allowEdit == resource.data.allowEdit));
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // A live editing session for one "Edited Video" item. It is addressed by its
    // unguessable document ID, is never listable, and only the person who
    // started it can rename it away from themselves or delete it. Everyone else
    // who has the link and is signed in may read it and write the timeline —
    // that is the whole point of the feature.
    //
    // The document holds the timeline as JSON plus a map of Cloud Storage
    // download URLs for the footage it uses, so invited editors can play clips
    // that live in the owner's storage.
    match /editSessions/{sessionId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Presence: one small document per device, refreshed on a heartbeat.
      match /peers/{peerId} {
        allow read, write: if request.auth != null;
      }
    }

    // Prepaid AI credits. Users may read their own balance and usage
    // ledger. They cannot create, change, or delete it — only Cloud
    // Functions using the Admin SDK may write, so a client cannot mint
    // credits or shrink a charge.
    match /billing/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

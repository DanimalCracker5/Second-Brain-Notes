rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The account meter enumerates this prefix to report actual Cloud Storage
    // usage, so signed-in users need list access for their own files as well
    // as the existing get/upload/delete access.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Photos added from a shared editing link. The path is unguessable; anyone
    // with the link can read, and signed-in editors can upload.
    match /shares/{shareId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.resource.size < 25 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
